# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.2

# Web search
TAVILY_API_KEY=
SEARCH_PROVIDER=duckduckgo
# SEARCH_PROVIDER=tavily   # requires TAVILY_API_KEY
# SEARCH_PROVIDER=fake     # offline / tests

# Academic papers
PAPERS_PROVIDER=arxiv

# Research plan
MAX_SUBQUESTIONS=5
MIN_SUBQUESTIONS=2
RESEARCHER_TIMEOUT_SECONDS=60
MAX_RETRIES=2

# Vector store (Chroma embedded — no separate service)
# In Docker these default to /app/... ; override locally if needed.
CHROMA_PERSIST_DIR=data/chroma
KB_SEED_PATH=data/kb_documents.json
KB_COLLECTION_NAME=internal_kb
KB_TOP_K=5

# Observability (optional LangSmith)
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-synthesis-agent
